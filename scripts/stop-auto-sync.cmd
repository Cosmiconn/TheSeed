@echo off&setlocal enabledelayedexpansion&title Stop TheSeed Auto-Sync&echo Stopping TheSeed Auto-Sync Daemon...&powershell -NoProfile -Command ^&{ $lock='.auto-sync.lock'; if(Test-Path $lock){ $pidOld=Get-Content $lock -EA SilentlyContinue; if($pidOld -and (Get-Process -Id $pidOld -EA SilentlyContinue)){ Stop-Process -Id $pidOld -Force -EA SilentlyContinue; Write-Host ('Stopped PID: {0}' -f $pidOld) -ForegroundColor Green } else { Write-Host 'Process not running, cleaning lock file.' -ForegroundColor Yellow } Remove-Item $lock -Force -EA SilentlyContinue } else { Write-Host 'Auto-sync is not running.' -ForegroundColor Cyan } }&echo.&pause&endlocal